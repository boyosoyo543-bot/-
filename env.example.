# رقم واتساب بالصيغة الدولية، بلا +
# مثال المغرب: 2126XXXXXXXX
PAIRING_PHONE_NUMBER=2126XXXXXXXX

# Railway يعطي PORT تلقائياً
PORT=3000

# خاص نفس المسار يكون مربوط بـ Railway Volume
AUTH_FOLDER=/data/auth_info

# أكثر من 5 ستيكرات يؤدي للطرد
STICKER_LIMIT=5

# المدة الزمنية بالثواني
STICKER_WINDOW_SECONDS=30

# مستوى السجلات
LOG_LEVEL=info
